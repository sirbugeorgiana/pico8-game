pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
  -- presupunem ca harta ta are 64 de tile-uri inaltime
  -- 64 tile-uri * 8 pixeli = 512 pixeli
  -- daca harta e mai lunga, mareste numarul 510
  p_x = 64
  p_y = 500  -- porneste de jos (aproape de pixelul 512)
  
  cam_y = p_y - 64
  
  viteza_pisica = 0.4
  viteza_laterala = 0.8
  
  timer_animatie = 0
  pisica_gura_inchisa = 1
  pisica_gura_deschisa = 2
  pisica_sprite_curent = 1
end

function _update()
  timer_animatie += 1
  
  -- animatie
  if timer_animatie % 30 < 15 then
    pisica_sprite_curent = pisica_gura_inchisa
  else
    pisica_sprite_curent = pisica_gura_deschisa
  end
  
  -- miscare automata in sus (scade y)
  -- verificam coliziunea cu flag 0
  if not fget(mget(p_x/8, (p_y-1)/8), 0) and
     not fget(mget((p_x+7)/8, (p_y-1)/8), 0) then
    p_y -= viteza_pisica
  end
  
  -- camera urmareste pisica pe verticala
  cam_y = p_y - 64
  
  -- limitam camera sa nu iasa peste marginea de sus a hartii
  if (cam_y < 0) cam_y = 0
  
  -- controale stanga/dreapta
  if btn(0) then
    if not fget(mget((p_x-1)/8, p_y/8), 0) and
       not fget(mget((p_x-1)/8, (p_y+7)/8), 0) then
      p_x -= viteza_laterala
    end
  end
  
  if btn(1) then
    if not fget(mget((p_x+8)/8, p_y/8), 0) and
       not fget(mget((p_x+8)/8, (p_y+7)/8), 0) then
      p_x += viteza_laterala
    end
  end
end

function _draw()
  cls()
  
  -- activam camera inainte de map si spr
  camera(0, cam_y)
  
  -- desenam harta (toata lungimea de 128 tile-uri)
  map(0, 0, 0, 0, 16, 128)
  
  spr(pisica_sprite_curent, p_x, p_y)
end
