pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
  -- rulam o functie separata care seteaza totul de la inceput
  restarteaza_jocul()
end

function restarteaza_jocul()
  -- pozitia de start a pisicii
  p_x = 60
  p_y = 16
  
  viteza_pisica = 1
  timer_mancat = 0
  timer_game_over = 0 -- timer pentru cele 2 secunde de asteptare
  stare_joc = "joaca" -- poate fi "joaca" sau "game_over"
  
  pisica_gura_inchisa = 1
  pisica_gura_deschisa = 2
  pisica_sprite_curent = 1
  
  numar_sprite_gogoasa = 16 
  numar_sprite_explozie = 17 
  
  scor = 0
  
  -- reincarcam harta initiala (ca sa reapara gogosile mancate)
  reload(0x2000, 0x2000, 0x1000)
end

function _update()
  -- daca suntem in ecranul de game over, doar numaram cele 2 secunde
  if stare_joc == "game_over" then
    timer_game_over += 1
    if timer_game_over >= 60 then -- 60 de cadre inseamna exact 2 secunde la 30fps
      restarteaza_jocul()
    end
    return -- oprim restul update-ului (pisica nu se mai misca)
  end

  -- logica pentru animatia de mancat
  if timer_mancat > 0 then
    timer_mancat -= 1
    pisica_sprite_curent = pisica_gura_deschisa
  else
    pisica_sprite_curent = pisica_gura_inchisa
  end
  
  local map_x = 0
  local map_y = 0

  -- miscare automata in jos + coliziune cu peretii (flag 0)
  if not fget(mget(map_x + p_x/8, map_y + (p_y+8)/8), 0) and
     not fget(mget(map_x + (p_x+7)/8, map_y + (p_y+8)/8), 0) then
    p_y += viteza_pisica
  else
    -- a lovit podeaua!
    stare_joc = "game_over"
  end
  
  -- miscare stanga
  if btn(0) then
    if not fget(mget(map_x + (p_x-1)/8, map_y + p_y/8), 0) and
       not fget(mget(map_x + (p_x-1)/8, map_y + (p_y+7)/8), 0) then
      p_x -= 1.5
    else
      -- a lovit peretele din stanga!
      stare_joc = "game_over"
    end
  end
  
  -- miscare dreapta
  if btn(1) then
    if not fget(mget(map_x + (p_x+8)/8, map_y + p_y/8), 0) and
       not fget(mget(map_x + (p_x+8)/8, map_y + (p_y+7)/8), 0) then
      p_x += 1.5
    else
      -- a lovit peretele din dreapta!
      stare_joc = "game_over"
    end
  end
  
  -- colectare gogosi
  local puncte = {
    {x = p_x + 2, y = p_y + 2},
    {x = p_x + 5, y = p_y + 2},
    {x = p_x + 2, y = p_y + 5},
    {x = p_x + 5, y = p_y + 5},
    {x = p_x + 4, y = p_y + 4}
  }
  
  for p in all(puncte) do
    local tile_x = flr(p.x / 8)
    local tile_y = flr(p.y / 8)
    
    if mget(tile_x, tile_y) == numar_sprite_gogoasa then
      mset(tile_x, tile_y, 0)
      scor += 1
      timer_mancat = 10
    end
  end
end

function _draw()
  cls()
  
  local cam_y = p_y - 64
  if cam_y < 0 then
    cam_y = 0
  end
  camera(0, cam_y)
  
  -- randeaza harta
  map(0, 0, 0, 0, 16, 64)
  
  if stare_joc == "game_over" then
    -- deseneaza doar flacara in locul unde a murit pisica
    spr(numar_sprite_explozie, p_x, p_y)
    
    -- dupa primele 15 cadre (ca sa apuci sa vezi flacara), punem ecranul de game over
    if timer_game_over > 15 then
      -- un dreptunghi negru pe tot ecranul (folosind coordonatele camerei ca sa ramana fix)
      rectfill(0, cam_y, 128, cam_y + 128, 0)
      
      -- textul de game over pozitionat pe mijloc
      print("g a m e   o v e r", 28, cam_y + 54, 14)
      print("scor final: " .. scor, 34, cam_y + 66, 7)
    end
  else
    -- deseneaza pisica in mod normal daca jocul ruleaza
    spr(pisica_sprite_curent, p_x, p_y)
  end
  
  -- afisare interfata scor normal (doar cand nu e ecranul negru de game over)
  if stare_joc == "joaca" or timer_game_over <= 15 then
    rectfill(2, cam_y + 2, 52, cam_y + 10, 0)
    print("gogosi: " .. scor, 4, cam_y + 4, 14)
  end
end
